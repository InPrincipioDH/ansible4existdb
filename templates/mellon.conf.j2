# /etc/apache2/conf-available/mellon.conf

<Location /mellon>
    SetHandler mellon-handler
    MellonEnable "info"

    MellonSecureCookie On

    MellonSPMetadataFile /etc/apache2/mellon/{{ mellon_outfile }}.xml
    MellonSPPrivateKeyFile /etc/apache2/mellon/{{ mellon_outfile }}.key
    MellonSPCertFile /etc/apache2/mellon/{{ mellon_outfile }}.cert
    MellonIdPMetadataFile /etc/apache2/mellon/idp_metadata.xml
</Location>

<Location {{ teipublisher_context_path }}>

    MellonEnable auth
    Require valid-user

    MellonSecureCookie On

    MellonSPMetadataFile /etc/apache2/mellon/{{ mellon_outfile }}.xml
    MellonSPPrivateKeyFile /etc/apache2/mellon/{{ mellon_outfile }}.key
    MellonSPCertFile /etc/apache2/mellon/{{ mellon_outfile }}.cert
    MellonIdPMetadataFile /etc/apache2/mellon/idp_metadata.xml
</Location>