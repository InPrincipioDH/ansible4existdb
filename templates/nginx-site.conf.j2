server {
    listen 80;
    listen [::]:80;
    server_name {{ inventory_hostname }};

	##
	# eXist-db settings
	##

	# see https://exist-db.org/exist/apps/doc/production_web_proxying
	# header helpers for reverse proxied servers
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header nginx-request-uri $request_uri;
    proxy_set_header X-Forwarded-Proto $scheme;

    location /exist {
        proxy_pass http://127.0.0.1:{{ exist_http_port }}$request_uri;

        allow 127.0.0.1;
        allow ::1;
        deny all;
    }

    # secure behind user management
    location /exist/webdav/db/projects/bspp {
        allow all;

        allow 127.0.0.1;
        allow ::1;
        deny all;
    }

    # secure behind user management
    location /exist/rest/db/projects/bspp {
        allow all;
    }

    # Optional additional application specific configurations
    include /etc/nginx/existdb-server.d/*.conf;

}