entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https

  websecure:
    address: ":443"

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ certificate_mail }}
      storage: /var/lib/traefik/acme.json

      httpChallenge:
        entryPoint: web

experimental:
  plugins:
    # Plugin necessary for traefik with SAML
    cookiePathRewrite:
      modulename: github.com/vnghia/traefik-plugin-rewrite-cookie-path
      version: v0.0.1
